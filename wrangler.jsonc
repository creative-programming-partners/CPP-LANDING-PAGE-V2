// Publicación en Cloudflare (Worker con archivos estáticos) en https://cppcstudio.com.
// Cloudflare despliega solo con cada push a main (Workers Builds: npx wrangler deploy).
// publicar.mjs copia a dist/ solo los archivos del sitio, para no publicar el README ni carpetas internas.
{
  "name": "cold-credit-ae5c",
  "compatibility_date": "2026-10-02",
  "build": { "command": "node publicar.mjs" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
